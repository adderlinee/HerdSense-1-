# Copy to .env on every device and fill in. NEVER commit .env.
# Everyone in the group uses the SAME GROUP_ID (long + random, share it privately).
GROUP_ID=change-me-to-something-long-and-random
# Unique per phone (e.g. your first name, no spaces or slashes)
MEMBER_NAME=member1

# Broker (public HiveMQ by default; no account needed)
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TLS=false          # use true with port 8883 for encrypted connection
MQTT_USERNAME=
MQTT_PASSWORD=

# Phone
SEND_INTERVAL_S=5         # seconds between messages (x STILL_INTERVAL_FACTOR while standing still)
STILL_INTERVAL_FACTOR=3  # battery saver: send/read GPS 3x less often when still
GPS_MAX_AGE_S=40         # do not send a GPS fix older than this
GPS_TIMEOUT_S=10         # give up on one GPS read after this many seconds

# Detector rules
SEPARATION_M=100        # distance from the rest of the group that counts as "far"
STALE_S=45              # no data for this long -> LOST_SIGNAL
MIN_ACCURACY_M=60       # GPS worse than this -> treated as no signal
GRACE_S=60              # stopped-and-far for this long -> escalates to SEPARATED
ALERT_COOLDOWN_S=30     # repeat alert interval while someone stays separated
LEADER_NAME=               # optional: this member's cluster is always "the group" (settles 2-vs-2 splits)
EMA_ALPHA=0.5               # GPS smoothing, 1.0 = off (smaller = smoother but slower)
